[style name="SmartphoneStyle"]
TestCharacter: Hiya!😘 Just got off work!
Player: wassup sexy
TestCharacter: Sorry to keep you waiting~
TestCharacter: Being a shop owner is just soooo busy. Would totes make me dizzy😵‍💫
TestCharacter: Well
TestCharacter: WOULD, if I wasn't such a natural at it~
TestCharacter: Surely I'm not disturbing your work hours?
TestCharacter: Speaking of...
TestCharacter: What do you do for work?
[wait time="0.1" hide_text="false"]
# This wait is here so the player has a buffer between clicking to progress from Text 2 and clicking to activate the intensity bar
# and selecting a dialogue choice. Without this, those two things happen simultaneously with a single click. Every time a timeline
# reaches a point where the player has to make a choice, always add this Wait function.
set {is_making_choice} = true
- Correct Choice
	set {is_making_choice} = false
	Player: i just picked a right choice
	TestCharacter: correct
	Player: yaaayyy
	Player: <Empty Text Event>
	[signal arg="date_time"]
	jump TextDateTimeline1/
	[end_timeline]
- Wrong Choice
	set {is_making_choice} = false
	Player: i just picked a wrong choice
	TestCharacter: wrong choice
	Player: noooo
- Wrong Choice
	set {is_making_choice} = false
	Player: I just picked a wrong choice
	TestCharacter: wrong choice
	Player: noooo
set {is_fdate_success} = false
set {is_date_success} = false
[signal arg="scene_end"]