[style name="SmartphoneStyle"]
TestCharacter: Hiya!😘 Just got off work! #id:11
Player: wassup sexy #id:12
TestCharacter: Sorry to keep you waiting~ #id:13
TestCharacter: Being a shop owner is just soooo busy. Would totes make me dizzy😵‍💫 #id:14
TestCharacter: Well #id:15
TestCharacter: WOULD, if I wasn't such a natural at it~ #id:16
TestCharacter: Surely I'm not disturbing your work hours? #id:17
TestCharacter: Speaking of... #id:18
TestCharacter: What do you do for work? #id:19
[wait time="0.1" hide_text="false"]
# This wait is here so the player has a buffer between clicking to progress from Text 2 and clicking to activate the intensity bar
# and selecting a dialogue choice. Without this, those two things happen simultaneously with a single click. Every time a timeline
# reaches a point where the player has to make a choice, always add this Wait function.
set {is_making_choice} = true
- Correct Choice #id:1a
	set {is_making_choice} = false
	Player: i just picked a right choice #id:1b
	TestCharacter: correct #id:1c
	Player: yaaayyy #id:1d
	Player: <Empty Text Event> #id:1e
	[signal arg="date_time"]
	jump TextDateTimeline1/
	[end_timeline]
- Wrong Choice #id:1f
	set {is_making_choice} = false
	Player: i just picked a wrong choice #id:20
	TestCharacter: wrong choice #id:21
	Player: noooo #id:22
- Wrong Choice #id:23
	set {is_making_choice} = false
	Player: I just picked a wrong choice #id:24
	TestCharacter: wrong choice #id:25
	Player: noooo #id:26
set {is_fdate_success} = false
set {is_date_success} = false
[signal arg="scene_end"]