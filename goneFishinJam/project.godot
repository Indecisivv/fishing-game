; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Fishin For Love"
config/description="In a city where some people have water creatures for heads, you hop on a dating app to fill the need you feel"
config/version="1.4"
run/main_scene="uid://2ohq8yurtaoa"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="uid://cwwudb00a8ls8"

[audio]

buses/default_bus_layout="uid://byak87m43kh8e"

[autoload]

Dialogic="*uid://ds2q0uclmolvu"
FadeToBlackTransition="*uid://d0sa6n0uewojx"
Character="*uid://t83f34umwp23"
CharacterLibrary="*uid://usyvxi2e3ij7"

[dialogic]

directories/dch_directory={
"Ada": "res://Timelines/Ada.dch",
"Khanh": "res://Timelines/Khanh.dch",
"Narrator": "res://Timelines/Narrator.dch",
"Player": "res://Characters/Player.dch",
"Socorro": "res://Timelines/Socorro.dch",
