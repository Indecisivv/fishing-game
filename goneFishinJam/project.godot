"TestCharacter2": "res://Characters/TestCharacter2.dch",
"TestCharacter3": "res://Characters/TestCharacter3.dch"
}
directories/dtl_directory={
"Timeline_Date_Ada": "res://Timelines/Timeline_Date_Ada.dtl",
"Timeline_Date_Khanh": "res://Timelines/Timeline_Date_Khanh.dtl",
"Timeline_Date_Socorro": "res://Timelines/Timeline_Date_Socorro.dtl",
"Timeline_Text_Ada": "res://Timelines/Timeline_Text_Ada.dtl",
"Timeline_Text_Khanh": "res://Timelines/Timeline_Text_Khanh.dtl",
"Timeline_Text_Socorro": "res://Timelines/Timeline_Text_Socorro.dtl"
}
layout/style_directory={
"": "res://Styles/SmartphoneStyle.tres",
"SmartphoneStyle": "res://Styles/SmartphoneStyle.tres",
"VisualNovelStyle": "res://Styles/VisualNovelStyle.tres"
}
layout/style_list=["res://Styles/VisualNovelStyle.tres", "res://Styles/SmartphoneStyle.tres"]
layout/default_style="res://Styles/SmartphoneStyle.tres"
text/letter_speed=0.0
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
choices/autofocus_first=false
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"Musicly": {
"audio_bus": "Music",
"fade_length": 1.5,
"loop": true,
"volume": 0.0
}
}
variables={
"is_date_success": false,
"is_fdate_success": false,
"is_making_choice": false,
"is_sdate_success": false,
"is_tdate_success": false
}
glossary/default_case_sensitive=true
layout/end_behaviour=0
audio/type_sound_bus="Audio"
text/input_action="dialogic_default_action"
text/autocolor_names=false
translation/enabled=true
translation/original_locale="en"
translation/file_mode=1
translation/translation_folder="res://Translations"
translation/save_mode=0
translation/add_separator=false
translation/intern/save_mode=0
translation/intern/file_mode=1
translation/intern/translation_folder="res://Translations"
translation/id_counter=693
translation/locales=[]

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1366
window/size/window_height_override=768
window/stretch/mode="canvas_items"
mouse_cursor/custom_image="uid://ds78h6rpuwvxo"
mouse_cursor/custom_image_hotspot=Vector2(20, 6)

[dotnet]

project/assembly_name="FishinForLove"

[editor_plugins]

